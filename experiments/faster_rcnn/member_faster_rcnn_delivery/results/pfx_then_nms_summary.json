  "protocol_id": "PFX_THEN_NMS",
  "role": "reference only; the main comparison is PFX_EXACT",
  "processing_order": "fixed candidates -> prefix allocation -> append NMS to the selection -> evaluate",
  "budget_semantics": "exact only before NMS; the actual post-NMS count is reported separately",
  "nms": {
    "iou_threshold": 0.5,
    "class_aware": true,
    "source": "external_assets\\frcnn_road8\\outputs\\frcnn_r18fpn_road8\\detector_declaration.json → threshold_nms_topn_order",
    "declared_steps": [
      "1. 对每个 RoI 的 9 维 pre-softmax class logits 做 softmax",
      "2. 只保留 8 个 Road8 前景类 (丢掉 background 列)",
      "3. score threshold = 0.0 (不设阈值)",
      "4. per-class NMS (torchvision batched_nms), IoU 阈值 = 0.5",
      "5. 各类拼接后按 score 取 top-300"
    ]
  },
  "not_yolo_iou": "IoU=0.70 只沿用 YOLO 既有参考; §07 明确不自动套用为 Faster R-CNN 的 NMS 参数。此处用的是本检测器冻结声明里的阈值。",
  "invariants": {
    "removed_equals_before_minus_after": true,
    "after_le_before": true,
    "slot_backfilling": false,
    "verified_rows": 50000
  },
  "does_not_establish": "PFX_THEN_NMS 不能证明 NMS_THEN_PFX 也有效: 后置 NMS 删掉重复记录后, 不会给其他图像补回原先失去的预算; 相对次序保留不等于已排除重复候选的作用。这是对处理顺序的逻辑解释, 不是已完成的因果实验。本文件不含 NMS_THEN_PFX 的任何数字。",
